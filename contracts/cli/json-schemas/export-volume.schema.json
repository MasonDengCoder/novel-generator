{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ExportChapterBody": {
      "additionalProperties": false,
      "description": "导出章节体（JSON 输出，正文以字段嵌入）。",
      "properties": {
        "content": {
          "type": "string"
        },
        "contentHash": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "wordCount": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "content",
        "contentHash",
        "createdAt",
        "id",
        "status",
        "title",
        "updatedAt",
        "wordCount"
      ],
      "type": "object"
    },
    "RuleCheck": {
      "additionalProperties": false,
      "description": "规则检查结果（对应 rule_checks 表行）。",
      "properties": {
        "chapter_id": {
          "type": "string"
        },
        "checked_at": {
          "type": "string"
        },
        "constraint_name": {
          "type": "string"
        },
        "constraint_scope": {
          "type": "string"
        },
        "constraint_type": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "passed": {
          "type": "boolean"
        },
        "severity": {
          "type": "string"
        }
      },
      "required": [
        "chapter_id",
        "checked_at",
        "constraint_name",
        "constraint_scope",
        "constraint_type",
        "content_hash",
        "id",
        "passed",
        "severity"
      ],
      "type": "object"
    },
    "Verdict": {
      "additionalProperties": false,
      "description": "裁决记录（对应 verdicts 表行）。",
      "properties": {
        "achieved": {
          "type": "boolean"
        },
        "chapterId": {
          "type": "string"
        },
        "contentHash": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "nodeId": {
          "type": "string"
        },
        "verdictType": {
          "type": "string"
        }
      },
      "required": [
        "achieved",
        "chapterId",
        "contentHash",
        "createdAt",
        "id",
        "nodeId",
        "verdictType"
      ],
      "type": "object"
    },
    "VolumeJson": {
      "additionalProperties": false,
      "properties": {
        "archivedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "order": {
          "format": "int64",
          "type": "integer"
        },
        "sealedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "volumeId": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "createdAt",
        "name",
        "order",
        "status",
        "updatedAt",
        "volumeId"
      ],
      "type": "object"
    }
  },
  "description": "`novel export volume` JSON 输出结构。",
  "properties": {
    "chapters": {
      "items": {
        "$ref": "#/definitions/ExportChapterBody"
      },
      "type": "array"
    },
    "emergences": {
      "items": {},
      "type": "array"
    },
    "exportedAt": {
      "type": "string"
    },
    "mainplotNodes": {
      "items": {},
      "type": "array"
    },
    "ruleChecks": {
      "items": {
        "$ref": "#/definitions/RuleCheck"
      },
      "type": "array"
    },
    "schemaVersion": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "threadBindings": {
      "items": {},
      "type": "array"
    },
    "verdicts": {
      "items": {
        "$ref": "#/definitions/Verdict"
      },
      "type": "array"
    },
    "volume": {
      "$ref": "#/definitions/VolumeJson"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "chapters",
    "emergences",
    "exportedAt",
    "mainplotNodes",
    "ruleChecks",
    "schemaVersion",
    "scope",
    "threadBindings",
    "verdicts",
    "volume",
    "warnings"
  ],
  "title": "ExportVolumeJson",
  "type": "object"
}